# Russia, in Russian. No secrets here: these are a country's settings, the
# starting point for a client's own file (SETUP.md, Another country), and what
# the demo for this country is built from. A client's copies of the files
# below go into clients/<id>/; the policy follows 152-FZ and still needs the
# client's lawyer. Personal data of Russian citizens is kept in Russia: a
# server of the client's own there (docs/deploy-vps.md), not Railway.
LOCALE=ru
LOCALE_FILE=countries/ru/texts.json
PRESET_FILE=countries/ru/form.yaml
PRIVACY_POLICY_FILE=countries/ru/policy.md
CURRENCY=RUB
TIMEZONE=Europe/Moscow
CARD_SIZE=90x50mm
