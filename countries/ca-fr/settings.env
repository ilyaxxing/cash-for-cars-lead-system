# Canada, in French (Québec): texts and a privacy policy in French under
# Québec's Law 25, with the Canadian form (countries/ca/form.yaml). No
# secrets here: these are a country's settings, the starting point for a
# client's own file (SETUP.md, Another country), and what the demo for this
# country is built from. A client's copies of the files below go into
# clients/<id>/; the policy still needs the client's lawyer.
LOCALE=fr
LOCALE_FILE=countries/ca-fr/texts.json
PRESET_FILE=countries/ca/form.yaml
PRIVACY_POLICY_FILE=countries/ca-fr/policy.md
CURRENCY=CAD
TIMEZONE=America/Toronto
CARD_SIZE=3.5x2in
