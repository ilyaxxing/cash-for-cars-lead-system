# Canada, in English: the shipped English texts with Canada's postal codes,
# kilometres and spelling laid over them, a form in kilometres, and a PIPEDA
# privacy policy. No secrets here: these are a country's settings, the
# starting point for a client's own file (SETUP.md, Another country), and
# what the demo for this country is built from. A client's copies of the
# files below go into clients/<id>/; the policy still needs the client's
# lawyer.
LOCALE=en
LOCALE_FILE=countries/ca/texts.json
PRESET_FILE=countries/ca/form.yaml
PRIVACY_POLICY_FILE=countries/ca/policy.md
CURRENCY=CAD
TIMEZONE=America/Toronto
CARD_SIZE=3.5x2in
SOURCE_LABELS=parking:Parking lot,flyer:Flyers
