# Germany, in German. No secrets here: these are a country's settings, the
# starting point for a client's own file (SETUP.md, Another country), and
# what the demo for this country is built from. A client's copies of the
# files below go into clients/<id>/; the policy follows the GDPR and the
# BDSG and still needs the client's lawyer. A German website also needs an
# Impressum (§ 5 DDG), which this system does not make: link it from the
# client's own site.
LOCALE=de
LOCALE_FILE=countries/de/texts.json
PRESET_FILE=countries/de/form.yaml
PRIVACY_POLICY_FILE=countries/de/policy.md
CURRENCY=EUR
TIMEZONE=Europe/Berlin
CARD_SIZE=85x55mm
