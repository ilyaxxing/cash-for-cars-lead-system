# France, in French. No secrets here: these are a country's settings, the
# starting point for a client's own file (SETUP.md, Another country), and
# what the demo for this country is built from. A client's copies of the
# files below go into clients/<id>/; the policy follows the GDPR and the
# loi Informatique et Libertés and still needs the client's lawyer.
LOCALE=fr
LOCALE_FILE=countries/fr/texts.json
PRESET_FILE=countries/fr/form.yaml
PRIVACY_POLICY_FILE=countries/fr/policy.md
CURRENCY=EUR
TIMEZONE=Europe/Paris
CARD_SIZE=85x55mm
SOURCE_LABELS=parking:Parking,flyer:Flyers
