# Poland, in Polish. No secrets here: these are a country's settings, the
# starting point for a client's own file (SETUP.md, Another country), and
# what the demo for this country is built from. A client's copies of the
# files below go into clients/<id>/; the policy follows the GDPR (RODO) and
# still needs the client's lawyer.
LOCALE=pl
LOCALE_FILE=countries/pl/texts.json
PRESET_FILE=countries/pl/form.yaml
PRIVACY_POLICY_FILE=countries/pl/policy.md
CURRENCY=PLN
TIMEZONE=Europe/Warsaw
CARD_SIZE=90x50mm
SOURCE_LABELS=parking:Parking,flyer:Ulotki
