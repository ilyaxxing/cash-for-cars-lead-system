# Spain, in Spanish. No secrets here: these are a country's settings, the
# starting point for a client's own file (SETUP.md, Another country), and
# what the demo for this country is built from. A client's copies of the
# files below go into clients/<id>/; the policy follows the GDPR and the
# LOPDGDD and still needs the client's lawyer.
LOCALE=es
LOCALE_FILE=countries/es/texts.json
PRESET_FILE=countries/es/form.yaml
PRIVACY_POLICY_FILE=countries/es/policy.md
CURRENCY=EUR
TIMEZONE=Europe/Madrid
CARD_SIZE=85x55mm
SOURCE_LABELS=parking:Aparcamiento,flyer:Folletos
