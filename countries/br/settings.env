# Brazil, in Portuguese. No secrets here: these are a country's settings,
# the starting point for a client's own file (SETUP.md, Another country),
# and what the demo for this country is built from. A client's copies of
# the files below go into clients/<id>/; the policy follows the LGPD and
# still needs the client's lawyer. Sellers here reach for WhatsApp first,
# so the form offers it first.
LOCALE=pt
LOCALE_FILE=countries/br/texts.json
PRESET_FILE=countries/br/form.yaml
PRIVACY_POLICY_FILE=countries/br/policy.md
CURRENCY=BRL
TIMEZONE=America/Sao_Paulo
CARD_SIZE=90x50mm
SOURCE_LABELS=parking:Estacionamento,flyer:Panfletos
