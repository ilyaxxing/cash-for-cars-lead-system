# The United States, in Spanish: the shipped US form (miles, ZIP codes,
# dollars) with texts and a privacy policy in Spanish. No secrets here: these
# are a country's settings, the starting point for a client's own file
# (SETUP.md, Another country), and what the demo for this country is built
# from. A client's copies of the files below go into clients/<id>/.
LOCALE=es
LOCALE_FILE=countries/us-es/texts.json
PRIVACY_POLICY_FILE=countries/us-es/policy.md
CURRENCY=USD
TIMEZONE=America/Chicago
CARD_SIZE=3.5x2in
