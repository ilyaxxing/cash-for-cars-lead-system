# Copy to .env for local development, or to clients/<name>.env for a client's
# Railway deploy (tools/deploy.py). Never commit a filled-in copy.

# --- Application ---
# development | production. Production refuses to start with missing secrets.
APP_ENV=development
LOG_LEVEL=INFO
# Public address of this instance, used in notification links.
# On Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN when left empty.
PUBLIC_URL=http://localhost:8000
# Header with the visitor's address, set by the hosting proxy (Railway: X-Real-IP,
# set by tools/deploy.py). Empty locally: the connecting address is used.
CLIENT_IP_HEADER=
# Signs owner sessions and seller upload tokens. At least 32 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Market and form ---
# Preset file name in presets/ (without .yaml)
PRESET=us-car-buyout
# Locale file name in locales/ (without .json)
LOCALE=en
CURRENCY=USD
# Times are stored in UTC and shown to the owner in this zone
TIMEZONE=America/New_York
# A client's own form, texts and privacy policy, for a market the shipped files
# don't cover (docs/customize-the-form.md). Empty: the shipped ones.
PRESET_FILE=
LOCALE_FILE=
PRIVACY_POLICY_FILE=

# --- Brand shown to sellers and in the dashboard ---
BRAND_NAME=Car Buyout
BRAND_PHONE=
# Accent color of buttons, links and the logo mark, #RRGGBB. Must be light
# enough to read on the dark screens. Empty: the designs' lime.
BRAND_COLOR=
# The client's own images, PNG, JPEG or WebP, e.g. clients/acme/logo.png.
# Empty: the built-in price-tag mark and car photo.
# Logo for the headers and sign-in: light lettering on a transparent
# background, at least 64 px tall.
BRAND_LOGO=
# Square home-screen icon, at least 192 px (512 is best). Empty: the logo if
# it is roughly square, otherwise the mark in BRAND_COLOR.
BRAND_ICON=
# Welcome screen photo: landscape, at least 1200 px wide.
BRAND_PHOTO=
# Business card size: 3.5x2in (US), 90x50mm (Russia), 85x55mm (Europe), or
# any card from 85x50mm to 92x56mm, e.g. 91x55mm (Japan)
CARD_SIZE=3.5x2in
# Font for card text in scripts the card's own font lacks (Chinese, Korean,
# Japanese, Greek...): a static .ttf file, e.g. Noto Sans SC Bold
CARD_FONT=

# --- Privacy policy ---
# The business that receives the leads (the data controller).
OPERATOR_NAME=
# Contact for privacy requests, shown on the policy page
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
# YYYY-MM-DD
POLICY_EFFECTIVE_DATE=

# --- Owner login ---
# Initial dashboard password. Changing it here and restarting resets the
# password set in the dashboard (the way back in if it is forgotten).
OWNER_PASSWORD=

# --- Database ---
# Local docker-compose database. On Railway this is a reference to the Postgres service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carbuyout

# --- Photo storage ---
# local: files under LOCAL_STORAGE_DIR (development only). volume: the same on a
# disk that outlives deploys (tools/deploy_vps.py sets it). s3: any S3-compatible bucket.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/uploads
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Notifications ---
# Channels that tell the owner about new leads, comma-separated.
NOTIFY_CHANNELS=push
# Web Push keys, once per instance:  python -m app.cli vapid-keys
# Changing them later signs every device out of notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: or https: URL
VAPID_SUBJECT=mailto:owner@example.com

# --- Lead sources ---
# Labels for your own ?src= values, comma-separated id:Label pairs.
# "card" (the /v short link on business cards) is built in.
SOURCE_LABELS=parking:Parking lot,flyer:Flyers

# --- Deploy (read by tools/deploy.py, never sent to the app) ---
# On Railway the database, the photo bucket, APP_ENV and STORAGE_BACKEND are
# set by the deploy script; the values above for them only matter locally.
# Leave PUBLIC_URL empty to use the Railway address, or set the client's own
# https:// domain. SECRET_KEY and the VAPID keys are generated if empty.
# Project name on Railway; defaults to BRAND_NAME.
RAILWAY_PROJECT_NAME=
# Workspace name or id, when the account has more than one.
RAILWAY_WORKSPACE=
# Photo bucket region (sjc, iad, ams, sin). Cannot be changed later.
RAILWAY_BUCKET_REGION=sjc
# Written by the deploy script on the first run. Keep it.
RAILWAY_PROJECT_ID=
